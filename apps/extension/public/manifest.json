{
  "manifest_version": 3,
  "name": "Helm",
  "version": "0.1.0",
  "description": "Helm extension",
  "permissions": ["storage", "notifications", "alarms", "tabs"],
  "host_permissions": [
    "https://www.freelancer.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3001/*",
      "http://127.0.0.1:3001/*",
      "https://helm.drhelm.uk/*",
      "https://*.drhelm.uk/*",
      "https://*.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Helm",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": [
        "https://www.freelancer.com/*",
        "https://freelancer.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.freelancer.com/projects",
        "https://www.freelancer.com/projects/*",
        "https://www.freelancer.com/projects/*/*",
        "https://www.freelancer.com/projects/*/*/*",
        "https://www.freelancer.com/projects/*/*/*/*",
        "https://freelancer.com/projects",
        "https://freelancer.com/projects/*",
        "https://freelancer.com/projects/*/*",
        "https://freelancer.com/projects/*/*/*",
        "https://freelancer.com/projects/*/*/*/*"
      ],
      "js": ["content/project.js"],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.freelancer.com/*",
        "https://freelancer.com/*"
      ],
      "js": ["content/listing.js"],
      "css": ["content/listing.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*",
        "https://helm.drhelm.uk/*",
        "https://*.drhelm.uk/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
