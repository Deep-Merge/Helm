# API — required for real AI proposals (get key at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional: Gemini fallback
GEMINI_API_KEY=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,chrome-extension://

# Dev mode: set ALLOW_DEV_TOKEN=true to skip login (extension dev only)
DEV_MODE=true
LOCAL_AUTH_SECRET=change-this-local-auth-secret
ALLOW_DEV_TOKEN=false

# Bootstrap admin (created/updated on API startup)
ADMIN_EMAIL=admin@yourteam.com
ADMIN_PASSWORD=change-this-password

# Local PostgreSQL (recommended — data stays on your machine)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bidautomation
MIGRATE_JSON_ON_STARTUP=false

# Legacy JSON fallback (only used when DATABASE_URL is empty)
LOCAL_PERSISTENCE=true
LOCAL_DATA_PATH=data/store.json
